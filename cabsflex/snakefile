        f"{config['out_dir']}/" + "{name}_{chain}_{start}-{end}_WT/{source}/{runtype}/model_quality/{n}_model_split.pdb"
    output:
        f"{config['out_dir']}/" + "{name}_{chain}_{start}-{end}_WT/{source}/{runtype}/model_quality/model_{n}.dssp"

rule report_SS:
    input:
        input_dssp = f"{config['out_dir']}/" + "{name}_{chain}_{start}-{end}_{wt}{resnum}{alt}/{source}/{runtype}/model_quality/input.dssp",
        input_pdb = f"{config['out_dir']}/" + "{name}_{chain}_{start}-{end}_{wt}{resnum}{alt}/{source}/{runtype}/input.pdb",
        models_dssp = expand(f"{config['out_dir']}/" + "{name}_{chain}_{start}-{end}_{wt}{resnum}{alt}/{source}/{runtype}/model_quality/model_{n}.dssp", n=range(config['cabsflex']['k-medoids']), allow_missing=True)

    output:
         f"{config['out_dir']}/" + "{name}_{chain}_{start}-{end}_{wt}{resnum}{alt}/{source}/{runtype}/model_quality/DSSP_models.csv"
         
    run:
        #DSSP SS for each position
        
        #List of valid DSSP categories
        dssp_letters = ["H", "B", "E", "G", "I", "T", "S"]
        
        #Open the dssp file for the input structure,
        #the input structure is the reference
        with open(input.input_dssp) as f: 
            lines = f.readlines()
        
        #identify the starting line of the site assigned values
        for line in enumerate(lines): 
            if "#  RESIDUE" in line[1]: 
                s = line[0]
        
        #prepare an empty dataframe for population
        df = pd.DataFrame(columns=['RESIDUE', 'CHAIN', 'AA', 'input_SS'])
        
        #in each site specific line the the data genrated by the dssp
        #is reduced. The dssp file formating is not tab, comma or 
        #space seperated, however the dirst four coulmns are the relevant
        #for secondary structure assigning.
        for line in range(s+1, len(lines)): 
            values = [] 
            l = lines[line].split(" ") 
            l = [x for x in l if x] 
            l = l[1:5] 
            #if a site is categorized as a coil, the column is empty. 
            #hence, the value from the "BP1" can be present in the fourth
            #position.
            #to covercome this, a check of the dssp_letters is made.
            #BP1 is a numberical value. 
            if l[-1] not in dssp_letters: 
                l[-1] = "-" 
            #addition of the residue to the prepared dataframe. 
            df.loc[len(df), ['RESIDUE', 'CHAIN', 'AA', 'input_SS']] = l
        
        #this generates a dataframe for the input structure with the original
        #assigned secondary structure. 
        
        #additionally, we need to have a quality measurement for each site, 
        #as reported in the b-factor of solved structures and pLDDT scores 
        #of alphafold structures. To assign a value, the input structure 
        #is analyzed.     
        ppdb = PandasPdb()
        pdb = ppdb.read_pdb(input.input_pdb)
        pdb_df = pdb.df['ATOM'][pdb.df['ATOM'].atom_name == 'CA']
        residue_numbers = list(pdb_df['residue_number'])
        b_factor = pdb_df['b_factor']
        b_df = pd.DataFrame({'RESIDUE':residue_numbers,'SITE_QUALITY':b_factor})
        b_df = b_df.drop_duplicates(subset=['RESIDUE'], keep='first')
        
        #in an effort to compare across predictive and solved structures, the b-factor
        #of the solved structure is transformed according the the pLDDT nomenclature.
        #strategy: normalizing the b-fcator to a score between 0-1, multiply with 100
        #to follow the same scale and subtract the value from 100 to have the best 
        #b-factor scoring residues have a high value - mirror of the pLDDT. 
        #An experimental structure may therefore have a super high estimated pLDDT score,
        #but one should remember to take the overall resolution of the structure 
        #into account. Hence, the best quality this structure can provide.
        #alo remember that the b-factor is stretched from 0-100 whereas the pLDDT score
        #often is within the 30-95 range.
        
        source = str(input.input_dssp).split("/")[-4]
        
        if ('af' or 'alphafold') not in source.lower():
            pLDDT_est = 100-(b_df.SITE_QUALITY-b_df.SITE_QUALITY.min())/(b_df.SITE_QUALITY.max()-b_df.SITE_QUALITY.min())*100
            b_df['SITE_QUALITY'] = pLDDT_est
        
        #merge to the original site specific dataframe
        df['RESIDUE']=df['RESIDUE'].astype(int)
        df = df.merge(b_df, on=['RESIDUE'])        
        df = df[['RESIDUE', 'CHAIN', 'AA', 'SITE_QUALITY', 'input_SS']]
        df['SITE_QUALITY']=df['SITE_QUALITY'].astype(float)
        
        #each of the models generated by CABSflex is added to the dataframe with
        #their respective site secondart structure assignments, following the 
        #same stategy as above.
        models_list = list(input.models_dssp)      
        
        for model in models_list: 
            m = model.split("/")[-1].split(".")[0]
        
            with open(model) as f:
                mlines = f.readlines()
           
            for line in enumerate(mlines): 
                if "#  RESIDUE" in line[1]:
                    s = line[0]
        
            SS_list = []
           
            for line in range(s+1, len(mlines)): 
                values = []
                l = mlines[line].split(" ")
                l = [x for x in l if x]
                l = l[1:5]
                if l[-1] not in dssp_letters:
                    l = "-"
                SS_list.append(l[-1])
            df[m] = SS_list
               
        df = df.reset_index(drop=True)
        
        #We now have a dataframe with the sequence, chain, amino acid, input SS,
        #a site quality score, and each SS of the models. 
        #When the secondary structure is different, it may be an artifact of 
        #low quality regions, such as loops or sections of disorder, to check this
        #we implement a similar score that only checks the confident sections.
        #high quality == pLDDT > 70
        hq_model_score = ['MODEL_SS_AGREEMENT_highQ', "-", "-", "-", "-"] 
        d1 = df[df.SITE_QUALITY >= 70.0]
        d2 = d1.drop(['RESIDUE', 'CHAIN', 'AA', 'input_SS', 'SITE_QUALITY'], axis=1)
        for model in d2.columns:
            hq_model_score.append(d1['input_SS'].eq(d1[model]).mean())
            
        #Calculating agreement fraction of the Secondary structure to the input. 
        #this provides a simple fraction indicating how many sites are in agreement, 
        #e.g. 0.5 would indicate that 50% of the sites retain the same DSSP assigned
        #SS between the model and the input.
        total_model_score = ['MODEL_SS_AGREEMENT_ALL', "-", "-", "-", "-"] 
        d = df.drop(['RESIDUE', 'CHAIN', 'AA', 'input_SS', 'SITE_QUALITY'], axis=1)
        for model in d.columns:
            total_model_score.append(df['input_SS'].eq(df[model]).mean())
            
        df.loc[len(df), list(df.columns)] = total_model_score
        df.loc[len(df), list(df.columns)] = hq_model_score
        
        df.to_csv(str(output), index=False)

use rule report_SS as report_SS_wt with:
    input:
        input_dssp = f"{config['out_dir']}/" + "{name}_{chain}_{start}-{end}_WT/{source}/{runtype}/model_quality/input.dssp",
        input_pdb = f"{config['out_dir']}/" + "{name}_{chain}_{start}-{end}_WT/{source}/{runtype}/input.pdb",
        models_dssp = expand(f"{config['out_dir']}/" + "{name}_{chain}_{start}-{end}_WT/{source}/{runtype}/model_quality/model_{n}.dssp", n=range(config['cabsflex']['k-medoids']), allow_missing=True)

    output:
         f"{config['out_dir']}/" + "{name}_{chain}_{start}-{end}_WT/{source}/{runtype}/model_quality/DSSP_models.csv"
