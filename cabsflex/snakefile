import pandas as pd
import numpy as np
import os
from Bio.PDB.Polypeptide import three_to_one, one_to_three

def get_ss(wildcards):

    this_ss_def = config['cabsflex']['run_types'][wildcards.runtype]['ss_def']

    if this_ss_def is None:
        return ""
    else:
        return f":{this_ss_def}"

def get_restraints(wildcards):

    this_restr = config['cabsflex']['run_types'][wildcards.runtype]['restraints']

    if this_restr is None:
        return ""
    else:
        return " ".join(this_restr)

configfile: 'config.yaml'

variants = pd.read_csv(config['variant_csv'])

targets = []
for v in variants['source_structure'].index:

    wcs = glob_wildcards(f"{config['pdb_dir']}/{variants.loc[v, 'pdb_dir']}/" + "{name}_{chain}_{wt,[A-Z]{3}}{resnum,[0-9]+}{alt,[A-Z]{3}}.pdb")
    wcs_wt = glob_wildcards(f"{config['pdb_dir']}/{variants.loc[v, 'pdb_dir']}/" + "{name}_{chain}_WT.pdb")

    wt_sl = [ three_to_one(r) for r in wcs.wt ]
    alt_sl = [ three_to_one(r) for r in wcs.alt ]
    
    #for mutations
    targets.extend(
        expand(
            expand(
                f"{config['out_dir']}/" +
                 "{name}_{chain}_" + 
                f"{variants.loc[v, 'aa_num_start']}-{variants.loc[v, 'aa_num_end']}_" +
                 "{wt}{resnum}{alt}/" +
                f"{variants.loc[v, 'source_type']}/" +
                 "{runtype}/output_pdbs/model_{n}.pdb", 
                 zip,
                 name=wcs.name,
                 chain=wcs.chain,
                 wt=wt_sl,
                 resnum=wcs.resnum,
                 alt=alt_sl,
                 allow_missing=True),
            runtype=list(config['cabsflex']['run_types'].keys()),
            n=np.arange(config['cabsflex']['k-medoids'])))
    
    #for WT
    targets.extend(
        expand(
            expand(
                f"{config['out_dir']}/" +
                 "{name}_{chain}_" +
                f"{variants.loc[v, 'aa_num_start']}-{variants.loc[v, 'aa_num_end']}_WT/" +
                f"{variants.loc[v, 'source_type']}/" +
                 "{runtype}/output_pdbs/model_{n}.pdb",
                 zip,
                 name=wcs.name,
                 chain=wcs.chain,
                 wt=wt_sl,
                 resnum=wcs.resnum,
                 alt=alt_sl,
                 allow_missing=True),
            runtype=list(config['cabsflex']['run_types'].keys()),
            n=np.arange(config['cabsflex']['k-medoids'])))

variants = variants.set_index('source_structure')

rule all:
    input:
        targets

rule run_cabsflex:
    input:
        lambda wcs: f"{config['pdb_dir']}/{variants.loc[wcs.name, 'pdb_dir']}/{wcs.name}_{wcs.chain}_{one_to_three(wcs.wt)}{wcs.resnum}{one_to_three(wcs.alt)}.pdb"
    output:
        expand(f"{config['out_dir']}/" + "{name}_{chain}_{start}-{end}_{wt}{resnum}{alt}/{source}/{runtype}/output_pdbs/model_{n}.pdb", n=range(config['cabsflex']['k-medoids']), allow_missing=True)
    wildcard_constraints:
        wt="[A-Z]",
        resnum="[0-9]+",
        alt="[A-Z]"
    params:
        restraints=get_restraints
        
    shell:
        """
        working_dir={config[out_dir]}/{wildcards.name}_{wildcards.chain}_{wildcards.start}-{wildcards.end}_{wildcards.wt}{wildcards.resnum}{wildcards.alt}/{wildcards.source}/{wildcards.runtype}
        
        cp {input} $working_dir/
        
        cd $working_dir
        
        #create a read me file
        cat <<EOF > README.txt
        
        Read me
            
        This directory contains a CABSflex run to model the flexibility of a structure.

        Structure: {wildcards.name}_{wildcards.chain}_{wildcards.start}-{wildcards.end}_{wildcards.wt}{wildcards.resnum}{wildcards.alt}.pdb
        Run type: {wildcards.runtype}

        This has been performed by running run.sh script, command: bash run.sh 
        
        And a log called CABS.log containing the output of the CABSflex run has also been written.
EOF
                
        cat <<EOF > run.sh
        
        ln -s $(basename {input}) input.pdb
        
        CABSflex\\
            -i input.pdb\\
            -k {config[cabsflex][k-medoids]}\\
            -v {config[cabsflex][verbose]}\\
            -C \\
            --dssp-command {config[cabsflex][dssp_location]}\\
            {params.restraints}\\
            --log
EOF
        
