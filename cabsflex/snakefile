rule prepare_models:
    input:
        pdb = f"{config['out_dir']}/" + "{name}_{chain}_{start}-{end}_{wt}{resnum}{alt}/{source}/{runtype}/theseus/theseus_sup.pdb",
        path = f"{config['out_dir']}/" + "{name}_{chain}_{start}-{end}_{wt}{resnum}{alt}/{source}/{runtype}/model_quality/input.dssp"
    output:
        expand(f"{config['out_dir']}/" + "{name}_{chain}_{start}-{end}_{wt}{resnum}{alt}/{source}/{runtype}/model_quality/{n}_model_split.pdb", n=range(config['cabsflex']['k-medoids']), allow_missing=True)
    run:
        #export path is choosen, -10 since len(input.dssp)=10 and input cannot be a path.
        path = (input.path)[:-10]
        
        #open the combined theseus_sup file
        with open(input.pdb) as f: 
            lines = f.readlines()
        
        #identification of each model:
        n_list = []
        start_list = []
        end_list = []
        for line in enumerate(lines): 
            if line[1].startswith("MODEL"): 
                n = ''.join(x for x in line[1] if x.isdigit())
                n_list.append(int(n)-1)
                start_list.append(line[0])
            if line[1].startswith('ENDMDL\n'):
                end_list.append(line[0])
        
        #export of each model in theseus_sup file
        for n in n_list: 
            with open(f'{path}/{n}_model_split.pdb', 'w') as f:
                for line in lines[start_list[n]:end_list[n]]:
                    f.write(line)
        
use rule prepare_models as prepare_models_wt with:
    input:
        pdb = f"{config['out_dir']}/" + "{name}_{chain}_{start}-{end}_WT/{source}/{runtype}/theseus/theseus_sup.pdb",
        path = f"{config['out_dir']}/" + "{name}_{chain}_{start}-{end}_WT/{source}/{runtype}/model_quality/input.dssp"
    output:
        expand(f"{config['out_dir']}/" + "{name}_{chain}_{start}-{end}_WT/{source}/{runtype}/model_quality/{n}_model_split.pdb", n=range(config['cabsflex']['k-medoids']), allow_missing=True)

rule model_dssp:
    input:
        f"{config['out_dir']}/" + "{name}_{chain}_{start}-{end}_{wt}{resnum}{alt}/{source}/{runtype}/model_quality/{n}_model_split.pdb"
    output:
